{
  "name": "dwg-viewer",
  "productName": "DWG Viewer",
  "version": "1.0.0",
  "description": "DWG Viewer - free viewer for DWG and DXF drawings (Android, iOS, Windows, macOS, Linux, web).",
  "author": {
    "name": "DWG Viewer",
    "url": "https://github.com/enoshvarma"
  },
  "homepage": "https://github.com/enoshvarma/ahuva-it-support-assistant/tree/main/dwg-viewer",
  "repository": {
    "type": "git",
    "url": "https://github.com/enoshvarma/ahuva-it-support-assistant.git",
    "directory": "dwg-viewer"
  },
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "build:dev": "node build.mjs --dev",
    "sample": "python3 scripts/make-sample.py assets/sample-house.dxf",
    "icons": "node scripts/make-icons.mjs",
    "start": "npm run build && electron .",
    "serve": "npm run build && node test/serve.mjs www 8080",
    "test": "node test/run-core-tests.mjs",
    "test:ui": "npm run build && node test/ui-test.mjs test/screens",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "cap:sync": "npm run build && npx cap sync",
    "android:apk": "npm run cap:sync && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.1",
    "@capacitor/filesystem": "^6.0.3",
    "@capacitor/share": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2",
    "@mlightcad/dxf-json": "^1.2.8",
    "@mlightcad/libredwg-web": "^0.7.15"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/ios": "^6.2.1",
    "@resvg/resvg-js": "^2.6.2",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "playwright": "^1.56.1",
    "png-to-ico": "^2.1.8",
    "png2icons": "^2.0.1"
  },
  "build": {
    "appId": "app.dwgviewer.desktop",
    "productName": "DWG Viewer",
    "copyright": "DWG Viewer - GPL-3.0",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "www/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "fileAssociations": [
      {
        "ext": "dwg",
        "name": "AutoCAD Drawing",
        "description": "AutoCAD Drawing",
        "role": "Viewer",
        "icon": "build/icon"
      },
      {
        "ext": "dxf",
        "name": "Drawing Exchange Format",
        "description": "DXF Drawing",
        "role": "Viewer",
        "icon": "build/icon"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "DWG-Viewer-${version}-${os}-${arch}-${target}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "DWG Viewer",
      "artifactName": "DWG-Viewer-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "DWG-Viewer-Portable-${version}.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.graphics-design",
      "artifactName": "DWG-Viewer-${version}-mac.${ext}",
      "identity": null,
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "DWG Viewer"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons",
      "category": "Graphics",
      "artifactName": "DWG-Viewer-${version}-linux-${arch}.${ext}",
      "maintainer": "enoshvarma <noreply@github.com>",
      "mimeTypes": [
        "image/vnd.dwg",
        "application/acad",
        "image/vnd.dxf",
        "application/dxf"
      ]
    }
  }
}
