<?xml version="1.0" encoding="utf-8"?>
<!-- LAN devices (routers, printers, cameras) are almost always plain HTTP. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
