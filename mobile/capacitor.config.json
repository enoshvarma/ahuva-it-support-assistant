{
  "appId": "com.ahuva.itsupport",
  "appName": "Ahuva IT Support",
  "webDir": "www",
  "server": {
    "androidScheme": "https",
    "allowNavigation": ["*"]
  },
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#07111f",
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#07111f"
    },
    "Keyboard": {
      "resize": "ionic",
      "resizeOnFullScreen": true
    },
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#07111f",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP",
      "splashFullScreen": true,
      "splashImmersive": true
    }
  }
}
