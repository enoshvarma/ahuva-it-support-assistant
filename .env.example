# Ahuva IT Support Assistant — Environment Example
# Copy this file to .env and fill in your values.
# .env is gitignored and MUST never be committed.
#
# These variables are optional overrides for CI/build environments.
# In normal desktop use, settings are stored via the in-app Settings panel.

# Override the Electron userData directory (useful for CI/testing)
# AHUVA_USER_DATA=/path/to/userdata

# Enable detailed debug logging to stdout
# AHUVA_LOG_LEVEL=debug

# Smoke-test mode: capture a screenshot to this path then quit
# AHUVA_SMOKE=/tmp/smoke.png
# AHUVA_SMOKE_OPEN=settings   # settings | packets | research | login

# Disable telemetry during development
# AHUVA_NO_TELEMETRY=1

# API keys and credentials are configured through the in-app Settings panel
# and stored in Electron's safeStorage-encrypted settings file.
# Do NOT put API keys in this file.
