# Normalise line endings to LF in the repository
* text=auto
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Binaries — no line-ending conversion
*.exe  binary
*.dll  binary
*.png  binary
*.ico  binary
*.icns binary
